{
  "format": 1,
  "id": "breath",
  "name": "Respiração",
  "description": "Sem forma nenhuma: o ecrã inteiro é um gradiente que roda, muda de cor e respira num ciclo lento. Pura luz de ambiente.",
  "tags": ["minimal", "luz", "respiração", "lento"],
  "fps": 24,
  "renderScale": 0.25,
  "feedback": false,
  "image": "none",
  "defaultPalette": ["#2a1033", "#6b2d5c", "#c0506a", "#f08a5d", "#f9d276"],
  "params": [
    { "id": "speed", "label": "Velocidade", "type": "float", "min": 0.0, "max": 1.0, "default": 0.3, "drift": 0.1 },
    { "id": "period", "label": "Ciclo (s)", "type": "float", "min": 4.0, "max": 60.0, "default": 18.0, "step": 1.0, "drift": 0.1 },
    { "id": "depth", "label": "Profundidade", "type": "float", "min": 0.0, "max": 1.0, "default": 0.5, "drift": 0.1 },
    { "id": "spread", "label": "Abertura", "type": "float", "min": 0.5, "max": 3.0, "default": 1.8, "drift": 0.2 },
    { "id": "pulse", "label": "Respirar (beat)", "type": "float", "min": 0.0, "max": 1.0, "default": 0.15, "drift": 0.0, "group": "Reatividade" }
  ]
}
