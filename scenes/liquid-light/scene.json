      "palette": ["#140a1e", "#2a6a2a", "#e0302a", "#f8a01e", "#fff06a"]
    },
    {
      "id": "oceano",
      "name": "Oceano",
      "params": { "speed": 0.2, "blobs": 4, "size": 0.3, "warp": 0.6 },
      "palette": ["#06121e", "#0e3a5a", "#1f8aa0", "#6fd0c0", "#e8fff0"]
    },
    {
      "id": "lava",
      "name": "Lâmpada de lava",
      "params": { "speed": 0.15, "blobs": 3, "size": 0.35, "warp": 0.4, "rim": 0.3 },
      "palette": ["#1e0812", "#5a0e1e", "#c8281e", "#f8781e", "#ffd06a"]
    }
  ]
