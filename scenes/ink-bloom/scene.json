{
  "format": 3,
  "id": "ink-bloom",
  "name": "Tinta",
  "description": "Gotas de tinta a cair em água: espalham-se, difundem-se e são levadas por correntes lentas. Feedback com difusão.",
  "tags": ["ambient", "tinta", "feedback", "orgânico", "lento"],
  "fps": 30,
  "renderScale": 0.5,
  "feedback": true,
  "image": "none",
  "defaultPalette": ["#0d1b3d", "#24306e", "#b23a8c", "#ff6f91", "#ffc97a"],
  "params": [
    { "id": "speed", "label": "Velocidade", "type": "float", "min": 0.0, "max": 1.0, "default": 0.4, "drift": 0.15 },
    { "id": "flow", "label": "Correntes", "type": "float", "min": 0.0, "max": 3.0, "default": 1.0, "drift": 0.25 },
    { "id": "scale", "label": "Escala do campo", "type": "float", "min": 0.5, "max": 6.0, "default": 2.0, "drift": 0.2 },
    { "id": "diffuse", "label": "Difusão", "type": "float", "min": 0.0, "max": 3.0, "default": 1.6, "drift": 0.1 },
    { "id": "decay", "label": "Persistência", "type": "float", "min": 0.95, "max": 0.999, "default": 0.996, "drift": 0.0 },
    { "id": "rate", "label": "Cadência", "type": "float", "min": 0.0, "max": 1.0, "default": 0.4, "drift": 0.1 },
    { "id": "pulse", "label": "Gota no beat", "type": "float", "min": 0.0, "max": 1.0, "default": 0.4, "drift": 0.0, "group": "Reatividade" }
  ],
  "presets": [
    {
      "id": "indigo",
      "name": "Índigo",
      "params": { "flow": 0.7, "diffuse": 2, "rate": 0.3 },
      "palette": ["#06101e", "#0e2448", "#2a4fa0", "#6fa0e0", "#d8ecff"]
    },
    {
      "id": "roma",
      "name": "Romã",
      "params": { "flow": 1.4, "rate": 0.5 },
      "palette": ["#1a0610", "#3a0e22", "#b0203a", "#f0604a", "#ffc0a0"]
    },
    {
      "id": "jade",
      "name": "Jade",
      "params": { "speed": 0.3, "flow": 0.8, "scale": 3, "diffuse": 1.2 },
      "palette": ["#04140f", "#0a3028", "#1f8a6a", "#7fd8a8", "#f0ffe0"]
    }
  ]
}
