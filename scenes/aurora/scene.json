      "palette": ["#03101f", "#0d2d52", "#2f6fb0", "#8cc6f0", "#e8f4ff"]
    },
    {
      "id": "brasa",
      "name": "Brasa",
      "params": { "speed": 0.25, "folds": 1.4, "glow": 0.6 },
      "palette": ["#140606", "#4a1410", "#c4402a", "#f59a4a", "#ffe0a0"]
