    { "id": "width", "label": "Largura", "type": "float", "min": 0.3, "max": 3.0, "default": 1.2, "drift": 0.2 },
    { "id": "folds", "label": "Pregas", "type": "float", "min": 0.0, "max": 2.0, "default": 1.0, "drift": 0.2 },
    { "id": "glow", "label": "Horizonte", "type": "float", "min": 0.0, "max": 1.0, "default": 0.4, "drift": 0.1 },
    { "id": "pulse", "label": "Respirar (beat)", "type": "float", "min": 0.0, "max": 1.0, "default": 0.25, "drift": 0.0, "group": "Reatividade" }
