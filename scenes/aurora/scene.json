{
  "format": 3,
  "id": "aurora",
  "name": "Aurora",
  "description": "Cortinas de luz que ondulam devagar, com pregas verticais e um horizonte que brilha. Formas grandes e saturadas.",
  "tags": ["ambient", "aurora", "lento", "atmosférico"],
  "fps": 30,
  "renderScale": 0.5,
