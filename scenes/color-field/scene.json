{
  "format": 1,
  "id": "color-field",
  "name": "Campo de Cor",
  "description": "Faixas de cor suaves e lentas, à maneira de Rothko. Minimal e ótimo para projetor.",
  "tags": ["ambient", "minimal", "lento", "campo de cor"],
  "fps": 30,
  "renderScale": 0.35,
  "feedback": false,
  "image": "optional",
  "defaultPalette": ["#2b0f1e", "#6b1d2f", "#b23a3a", "#e07b39", "#f3c27a"],
  "params": [
    { "id": "speed",     "label": "Velocidade",     "type": "float", "min": 0.0, "max": 1.0, "default": 0.2,  "drift": 0.1 },
    { "id": "bands",     "label": "Faixas",         "type": "int",   "min": 2,   "max": 5,   "default": 3,    "drift": 0.0 },
    { "id": "softness",  "label": "Suavidade",      "type": "float", "min": 0.05,"max": 0.95,"default": 0.6,  "drift": 0.2 },
    { "id": "wobble",    "label": "Ondulação",      "type": "float", "min": 0.0, "max": 1.0, "default": 0.4,  "drift": 0.3 },
    { "id": "pulse",     "label": "Respirar (beat)","type": "float", "min": 0.0, "max": 1.0, "default": 0.3,  "drift": 0.0, "group": "Reatividade" },
    { "id": "vignette",  "label": "Vinheta",        "type": "float", "min": 0.0, "max": 2.0, "default": 0.8,  "drift": 0.0 }
  ]
}
