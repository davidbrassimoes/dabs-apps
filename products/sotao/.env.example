# libSQL / SQLite. Local file in dev (file:local.db). In production the Worker
# gets a libsql:// Turso URL as a secret (wrangler.jsonc) — never from this file.
DATABASE_URL=

# Turso auth token. Leave empty for a local file database.
DATABASE_AUTH_TOKEN=

# The single password for the one user (§10).
APP_PASSWORD=

# 32+ random bytes, hex or base64, for signing the session cookie.
APP_SECRET=
