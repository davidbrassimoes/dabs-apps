// Sótão on Cloudflare Workers, the database on Cloudflare D1 (projects/sotao.md,
// decision 8). A Worker of its own, in the same account as Escarpa Audio.
//
// Deploy with `npm run deploy`. The app migrates and seeds the
// database itself on its first request; do not also run `wrangler d1 migrations
// apply`. Secrets are set once with `npx wrangler secret put <NAME>` and never
// live in this file:
//
//   APP_PASSWORD         the one password (§10)
//   APP_SECRET           32+ random bytes, signs the session cookie
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "sotao",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-09-01",
	// node:crypto, for signing the session cookie (src/lib/server/auth.ts).
	"compatibility_flags": ["nodejs_compat"],
	"send_metrics": false,
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "sotao",
			// Created with `wrangler d1 create sotao` on 2026-10-06 (region WEUR).
			// Local dev (vite dev, miniflare) keeps its own copy in .wrangler/state.
			"database_id": "f0a7ad97-2ba5-410a-a8a2-dfd989dda3fc",
			"migrations_dir": "drizzle"
		}
	],
	// Reached at sotao.<account>.workers.dev for now. A custom domain is a
	// decision, not a default — nothing here is public but the login page.
	"workers_dev": true,
	"preview_urls": false
}
