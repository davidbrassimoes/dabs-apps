      "params": { "speed": 0.2, "rate": 0.12, "amount": 0.3, "slices": 8, "pulse": 0.15 },
      "palette": ["#0f1420", "#24304a", "#4f7a8a", "#d8a07a", "#f4e6cf"]
    },
    {
      "id": "terminal",
      "name": "Terminal",
      "params": { "rate": 0.3, "amount": 0.5, "slices": 30 },
      "palette": ["#020a06", "#0a2a18", "#1a7a40", "#5fe08a", "#d8ffd0"]
    }
  ]
