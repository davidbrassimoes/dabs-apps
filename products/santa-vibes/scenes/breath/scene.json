    { "id": "depth", "label": "Profundidade", "type": "float", "min": 0.0, "max": 1.0, "default": 0.5, "drift": 0.1 },
    { "id": "spread", "label": "Abertura", "type": "float", "min": 0.5, "max": 3.0, "default": 1.8, "drift": 0.2 },
    { "id": "pulse", "label": "Respirar (beat)", "type": "float", "min": 0.0, "max": 1.0, "default": 0.15, "drift": 0.0, "group": "Reatividade" },
    { "id": "react", "label": "Reação à música", "type": "float", "min": 0.0, "max": 1.0, "default": 0.0, "drift": 0.0, "group": "Reatividade" }
  ],
  "presets": [
